generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id          String                @id @default(uuid()) @db.Uuid
  plateNumber String                @map("plate_number") @db.VarChar(255)
  model       String                @db.VarChar(255)
  status      String
  odometer    Int
  isActive    Boolean               @map("is_active")
  capacity    Int?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")
  schedules   MaintenanceSchedule[] @relation("VehicleSchedules")

  @@map("vehicles")
}

model MaintenanceSchedule {
  id                         String            @id @default(uuid()) @db.Uuid
  vehicleId                  String
  title                      String            @db.VarChar(255)
  garageId                   String?           @map("garage_id") @db.VarChar(255)
  accountType                String?           @map("account_type")
  status                     MaintenanceStatus
  assignedMechanic           String?           @map("assigned_mechanic") @db.VarChar(255)
  checklistTemplateId        String?           @map("checklist_template_id") @db.Uuid
  odometerReading            Int?              @map("odometer_reading")
  triggerType                String?           @map("trigger_type")
  intervalKm                 Int?              @map("interval_km")
  bufferDistanceKm           Int?              @map("buffer_distance_km")
  startingReferenceReadingKm Int?              @map("starting_reference_reading_km")
  intervalType               String?           @map("interval_type")
  startReferenceDate         DateTime?         @map("start_reference_date")
  previousScheduleId         String?           @map("previous_schedule_id") @db.Uuid
  workOrderProgress          Json?             @map("work_order_progress")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  deletedAt                  DateTime?         @map("deleted_at")

  vehicle           Vehicle?           @relation("VehicleSchedules", fields: [vehicleId], references: [id])
  checklistTemplate ChecklistTemplate? @relation("ChecklistTemplateSchedules", fields: [checklistTemplateId], references: [id])

  @@map("maintenance_schedules")
}

enum MaintenanceStatus {
  PENDING
  DUE
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model ChecklistTemplate {
  id        String                @id @default(uuid()) @db.Uuid
  type      String                @db.VarChar(255)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  deletedAt DateTime?             @map("deleted_at")
  items     ChecklistItem[]
  schedules MaintenanceSchedule[] @relation("ChecklistTemplateSchedules")

  @@map("checklist_templates")
}

model ChecklistItem {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String            @map("checklist_template_id") @db.Uuid
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])
  order      Int
  text       String            @db.Text
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deletedAt  DateTime?         @map("deleted_at")

  @@map("checklist_items")
}

model MaintenanceEmbeddings {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String?  @db.Uuid
  templateId String?  @db.Uuid
  sourceType String   @db.VarChar(32)
  content    String   @db.Text
  embedding  Bytes
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("maintenance_embeddings")
}
