# Environment Configuration
PORT=3001
NODE_ENV=development
VMMS_API_BASE_URL="http://localhost:3000"

# Database Connection (Docker local config by default)
DATABASE_URL="postgresql://welinc_user:welinc_pass@localhost:5432/welinc_db?schema=public"

# Data mart and 1536-dimension embeddings
DUCKDB_PATH="./database/vmms_datamart.duckdb"
ANALYTICS_MAX_AGE_MINUTES=1440
GEMINI_API_KEY=""
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta2"
GEMINI_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_BATCH_SIZE=100
